        "\"\"\"\n",
        "Exercício 1 | O Simulador \"Desfazer\"\n",
        "\n",
        "Objetivo: Implementar uma Pilha (Stack) para gerenciar ações em um editor de texto.\n",
        "\n",
        "Ideia:\n",
        "- Cada ação (digitar, apagar, substituir) é guardada numa pilha.\n",
        "- A função desfazer() tira a última ação da pilha e chama uma sub-função\n",
        "  específica pra reverter aquele tipo de ação (uma pra cada: digitar,\n",
        "  apagar, substituir).\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "class Pilha:\n",
        "\n",
        "    def __init__(self):\n",
        "        self.itens = []\n",
        "\n",
        "    def empilhar(self, item):\n",
        "        self.itens.append(item)\n",
        "\n",
        "    def desempilhar(self):\n",
        "        if self.esta_vazia():\n",
        "            return None\n",
        "        return self.itens.pop()\n",
        "\n",
        "    def esta_vazia(self):\n",
        "        return len(self.itens) == 0\n",
        "\n",
        "\n",
        "class EditorDeTexto:\n",
        "\n",
        "    def __init__(self):\n",
        "        self.texto = \"\"\n",
        "        self.historico = Pilha()\n",
        "\n",
        "    # ---------- AÇÕES DO EDITOR ----------\n",
        "\n",
        "    def digitar(self, texto_novo):\n",
        "        acao = {\n",
        "            \"tipo\": \"digitar\",\n",
        "            \"texto_adicionado\": texto_novo\n",
        "        }\n",
        "        self.texto += texto_novo\n",
        "        self.historico.empilhar(acao)\n",
        "        print(f\"[digitar] '{texto_novo}' -> texto atual: '{self.texto}'\")\n",
        "\n",
        "    def apagar(self, qtd_caracteres):\n",
        "        qtd_caracteres = min(qtd_caracteres, len(self.texto))\n",
        "\n",
        "        texto_removido = self.texto[-qtd_caracteres:] if qtd_caracteres > 0 else \"\"\n",
        "        self.texto = self.texto[:len(self.texto) - qtd_caracteres]\n",
        "\n",
        "        acao = {\n",
        "            \"tipo\": \"apagar\",\n",
        "            \"texto_removido\": texto_removido\n",
        "        }\n",
        "        self.historico.empilhar(acao)\n",
        "        print(f\"[apagar] removeu '{texto_removido}' -> texto atual: '{self.texto}'\")\n",
        "\n",
        "    def substituir(self, texto_antigo, texto_novo):\n",
        "        if texto_antigo not in self.texto:\n",
        "            print(f\"[substituir] '{texto_antigo}' não encontrado no texto, nada foi feito.\")\n",
        "            return\n",
        "\n",
        "        self.texto = self.texto.replace(texto_antigo, texto_novo, 1)\n",
        "\n",
        "        acao = {\n",
        "            \"tipo\": \"substituir\",\n",
        "            \"texto_antigo\": texto_antigo,\n",
        "            \"texto_novo\": texto_novo\n",
        "        }\n",
        "        self.historico.empilhar(acao)\n",
        "        print(f\"[substituir] '{texto_antigo}' -> '{texto_novo}' | texto atual: '{self.texto}'\")\n",
        "\n",
        "    # ---------- DESFAZER ----------\n",
        "\n",
        "    def desfazer(self):\n",
        "        \"\"\"\n",
        "        Pega a última ação da pilha e reverte ela no texto.\n",
        "        Todo o processo de reverter fica aqui dentro: pra cada tipo de ação\n",
        "        (digitar, apagar, substituir) tem uma sub-função que sabe como\n",
        "        desfazer aquele tipo específico.\n",
        "        \"\"\"\n",
        "\n",
        "        def _desfazer_digitar(acao):\n",
        "            texto_adicionado = acao[\"texto_adicionado\"]\n",
        "            self.texto = self.texto[:len(self.texto) - len(texto_adicionado)]\n",
        "\n",
        "        def _desfazer_apagar(acao):\n",
        "            self.texto += acao[\"texto_removido\"]\n",
        "\n",
        "        def _desfazer_substituir(acao):\n",
        "            self.texto = self.texto.replace(\n",
        "                acao[\"texto_novo\"],\n",
        "                acao[\"texto_antigo\"],\n",
        "                1\n",
        "            )\n",
        "\n",
        "        ultima_acao = self.historico.desempilhar()\n",
        "\n",
        "        if ultima_acao is None:\n",
        "            print(\"[desfazer] Não tem nenhuma ação pra desfazer.\")\n",
        "            return\n",
        "\n",
        "        tipo = ultima_acao[\"tipo\"]\n",
        "\n",
        "        # chama a sub-função certa de acordo com o tipo da ação\n",
        "        if tipo == \"digitar\":\n",
        "            _desfazer_digitar(ultima_acao)\n",
        "        elif tipo == \"apagar\":\n",
        "            _desfazer_apagar(ultima_acao)\n",
        "        elif tipo == \"substituir\":\n",
        "            _desfazer_substituir(ultima_acao)\n",
        "\n",
        "        print(f\"[desfazer] ação '{tipo}' revertida -> texto atual: '{self.texto}'\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    editor = EditorDeTexto()\n",
        "\n",
        "    print(\"=== Simulação ===\\n\")\n",
        "\n",
        "    editor.digitar(\"Ola mundo\")\n",
        "    editor.digitar(\", tudo bem?\")\n",
        "    editor.apagar(5)\n",
        "    editor.substituir(\"Ola\", \"Oi\")\n",
        "\n",
        "    print(\"\\n--- Começando a desfazer ---\\n\")\n",
        "\n",
        "    editor.desfazer()  # desfaz o substituir\n",
        "    editor.desfazer()  # desfaz o apagar\n",
        "    editor.desfazer()  # desfaz o segundo digitar\n",
        "    editor.desfazer()  # desfaz o primeiro digitar\n",
        "    editor.desfazer()  # pilha já vazia, deve avisar"
