        "class hospital:\n",
        "    def __init__(self):\n",
        "        self.fila = []\n",
        "\n",
        "    def adicionar_paciente(self, nome):\n",
        "        self.fila.append(nome)\n",
        "        print(f\"{nome} registrado!\")\n",
        "\n",
        "    def remover(self, nome):\n",
        "        if nome in self.fila:\n",
        "            self.fila.remove(nome)\n",
        "            print(f\"{nome} foi removido da fila.\")\n",
        "        else:\n",
        "            print(f\"{nome} não está na fila.\")\n",
        "\n",
        "    def mostrar_fila(self):\n",
        "        print(\"Fila de espera:\")\n",
        "        for nome in self.fila:\n",
        "            print(\"-\", nome)\n",
        "\n",
        "    def prioridade(self, nome):\n",
        "        # Corrigido de append para insert\n",
        "        self.fila.insert(0, nome)\n",
        "        print(f\"{nome} foi adicionado à fila de prioridade.\")\n",
        "\n",
        "\n",
