        "\"\"\"\n",
        "Exercício 2 | O Sistema de Impressão\n",
        "\n",
        "Objetivo: Implementar uma Fila (Queue) para gerenciar um spooler de impressora.\n",
        "\n",
        "Ideia:\n",
        "- Cada novo documento enviado pra impressão entra no final da fila (enfileirar).\n",
        "- Quando a impressora vai imprimir, ela sempre pega o documento mais antigo\n",
        "  que tá esperando (o primeiro que entrou), porque fila é FIFO\n",
        "  (primeiro que entra, primeiro que sai).\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "class Fila:\n",
        "    \"\"\"Implementação simples de fila (FIFO) usando lista.\"\"\"\n",
        "\n",
        "    def __init__(self):\n",
        "        self.itens = []\n",
        "\n",
        "    def enfileirar(self, item):\n",
        "\n",
        "        self.itens.append(item)\n",
        "\n",
        "    def desenfileirar(self):\n",
        "\n",
        "        if self.esta_vazia():\n",
        "            return None\n",
        "        return self.itens.pop(0)\n",
        "\n",
        "    def esta_vazia(self):\n",
        "        return len(self.itens) == 0\n",
        "\n",
        "    def tamanho(self):\n",
        "        return len(self.itens)\n",
        "\n",
        "\n",
        "class SpoolerDeImpressora:\n",
        "\n",
        "\n",
        "    def __init__(self):\n",
        "        self.fila_de_impressao = Fila()\n",
        "\n",
        "    def enviar_documento(self, nome_documento):\n",
        "        self.fila_de_impressao.enfileirar(nome_documento)\n",
        "        print(f\"[enviado] '{nome_documento}' entrou na fila de impressão.\")\n",
        "\n",
        "    def imprimir_proximo(self):\n",
        "        documento = self.fila_de_impressao.desenfileirar()\n",
        "\n",
        "        if documento is None:\n",
        "            print(\"[imprimir] Não tem nenhum documento na fila.\")\n",
        "            return\n",
        "\n",
        "        print(f\"[imprimindo] '{documento}'\")\n",
        "\n",
        "    def documentos_na_fila(self):\n",
        "        print(f\"[fila] {self.fila_de_impressao.tamanho()} documento(s) aguardando.\")\n",
        "\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    impressora = SpoolerDeImpressora()\n",
        "\n",
        "    print(\"=== Simulação ===\\n\")\n",
        "\n",
        "    impressora.enviar_documento(\"relatorio.pdf\")\n",
        "    impressora.enviar_documento(\"foto_ferias.jpg\")\n",
        "    impressora.enviar_documento(\"contrato.docx\")\n",
        "\n",
        "    impressora.documentos_na_fila()\n",
        "\n",
        "    print(\"\\n--- Imprimindo ---\\n\")\n",
        "\n",
        "    impressora.imprimir_proximo()\n",
        "    impressora.imprimir_proximo()\n",
        "    impressora.documentos_na_fila()\n",
        "\n",
        "    impressora.imprimir_proximo()\n",
        "    impressora.imprimir_proximo()"
